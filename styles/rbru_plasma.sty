\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/rbru_plasma}[2026/10/17 RBRU Plasma Physics & Thai Academic Textbook Standard Package]

% --- 1. Page Geometry (6x9 inch / Royal 8vo) ---
\RequirePackage{geometry}
\geometry{
    paperwidth=6in,
    paperheight=9in,
    left=1.25in,
    right=1.0in,
    top=1.0in,
    bottom=1.0in,
    headheight=15pt,
    headsep=0.25in,
    footskip=0.4in
}

