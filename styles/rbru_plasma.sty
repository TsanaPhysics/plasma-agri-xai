% --- 3. Font and Thai Language Typography ---
\RequirePackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}

% Font selection: prioritize local project fonts, then system fonts
\IfFileExists{fonts/THSarabun.ttf}{
    \setmainfont{THSarabun.ttf}[
        Path = ./fonts/,
        Scale = 1.18,
        BoldFont = {THSarabun Bold.ttf},
        ItalicFont = {THSarabun Italic.ttf},
        BoldItalicFont = {THSarabun BoldItalic.ttf}
    ]
}{
    \IfFontExistsTF{TH Sarabun New}{
        \setmainfont{TH Sarabun New}[Scale=1.18]
    }{
        \setmainfont{Sarabun}[Scale=1.18]
    }
}

% Thai Localization Strings for Academic Textbooks
\renewcommand{\chaptername}{บทที่}
\renewcommand{\contentsname}{สารบัญ}
\renewcommand{\listfigurename}{สารบัญภาพ}
\renewcommand{\listtablename}{สารบัญตาราง}
\renewcommand{\bibname}{บรรณานุกรม}
\renewcommand{\indexname}{ดัชนี}
\renewcommand{\figurename}{ภาพที่}
\renewcommand{\tablename}{ตารางที่}

% Thai linebreak and orphan word prevention
\XeTeXlinebreaklocale "th"
\XeTeXlinebreakskip = 0pt plus 2pt minus 0.5pt
\setlength{\emergencystretch}{2.5em}

% Standard RBRU 1 Tab (1.25 cm) Indentation
\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{4pt plus 1pt minus 1pt}

% Penalties to eliminate widow and orphan lines
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

% --- 4. Math, Symbols & Chemistry Packages ---
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\RequirePackage{mhchem} % For chemical equations and RONS (O2, NO, OH*, etc.)
\RequirePackage{siunitx}
\sisetup{detect-all, range-phrase=--}

% --- 5. Graphicx, TikZ & Floating Objects ---
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows.meta,calc,positioning,decorations.pathmorphing,backgrounds,fadings,shadows}
\RequirePackage{float}
\RequirePackage{needspace}
\RequirePackage[section]{placeins}

% --- 6. Tables & Lists ---
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{enumitem}
\setlist{nosep, leftmargin=1.5em, topsep=2pt, itemsep=2pt}

% --- 7. Captions (RBRU Standard: Bold label, normal text, quad space, no colons) ---
\RequirePackage{caption}
\DeclareCaptionLabelSeparator{thaisep}{\quad}
\captionsetup{labelsep=thaisep}
\captionsetup[table]{
    position=top,
    skip=6pt,
    labelfont={bf,color=primaryThemeColor},
    textfont={normalfont},
    labelsep=thaisep,
    justification=raggedright,
    singlelinecheck=false
}
\captionsetup[figure]{
    position=bottom,
    skip=8pt,
    labelfont={bf,color=primaryThemeColor},
    textfont={normalfont},
    labelsep=thaisep,
    justification=centering
}

% --- 8. Running Headers & Footers (No trailing period) ---
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% Even pages (verso - left): Page number on left, Chapter title on right
\fancyhead[LE]{\fontsize{9.5}{12}\selectfont\thepage}
\fancyhead[RE]{\fontsize{9.5}{12}\selectfont\nouppercase{\leftmark}}

% Odd pages (recto - right): Section title on left, Page number on right
\fancyhead[LO]{\fontsize{9.5}{12}\selectfont\nouppercase{\rightmark}}
\fancyhead[RO]{\fontsize{9.5}{12}\selectfont\thepage}

% Redefine chaptermark to eliminate trailing period
\renewcommand{\chaptermark}[1]{%
    \markboth{%
        \ifnum \c@secnumdepth >\m@ne
            \if@mainmatter
                \chaptertitlename\ \thechapter\quad
            \fi
        \fi
        #1%
    }{}%
}
\renewcommand{\sectionmark}[1]{%
    \markright{%
        \ifnum \c@secnumdepth >\z@
            \thesection\quad
        \fi
        #1%
    }%
}

\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[C]{\fontsize{9.5}{12}\selectfont\thepage}
    \renewcommand{\headrulewidth}{0pt}
}

% --- 9. Section & Chapter Titles (Hierarchical Indentation & No Colons) ---
\RequirePackage{titlesec}

% Chapter formatting: Elegant Academic Banner (Numbered)
\titleformat{\chapter}[display]
    {\bfseries\fontsize{18}{22}\selectfont\color{primaryThemeColor}}
    {\filright\fontsize{14}{18}\selectfont\color{secondaryThemeColor}\chaptertitlename\ \thechapter}
    {6pt}
    {\titlerule\vspace{6pt}\filright}
    [\vspace{6pt}\titlerule]
\titlespacing*{\chapter}{0pt}{0pt}{18pt}

% Chapter formatting: Unnumbered (Preface, References, Index)
\titleformat{name=\chapter,numberless}[block]
    {\bfseries\fontsize{18}{22}\selectfont\color{primaryThemeColor}}
    {}
    {0pt}
    {\filright}
    [\vspace{6pt}\titlerule]
\titlespacing*{name=\chapter,numberless}{0pt}{0pt}{18pt}

% Section (Level 1): starts at left margin, number box is 1.25cm wide so text aligns at 1.25cm
\titleformat{\section}
    {\bfseries\fontsize{14}{18}\selectfont\color{primaryThemeColor}}
    {\makebox[1.25cm][l]{\thesection}}
    {0pt}
    {}
\titlespacing*{\section}{0pt}{14pt plus 3pt minus 2pt}{6pt plus 2pt minus 1pt}

% Subsection (Level 2): indented 1.25cm, number box 1.25cm so text starts at 2.50cm
\titleformat{\subsection}
    {\bfseries\fontsize{12.5}{16}\selectfont\color{secondaryThemeColor}}
    {\makebox[1.25cm][l]{\thesubsection}}
    {0pt}
    {}
\titlespacing*{\subsection}{1.25cm}{12pt plus 3pt minus 2pt}{5pt plus 2pt minus 1pt}

% Subsubsection (Level 3): indented 2.50cm, number box 1.25cm so text starts at 3.75cm
\titleformat{\subsubsection}
    {\bfseries\fontsize{11.5}{15}\selectfont\color{accentThemeColor}}
    {\makebox[1.25cm][l]{\thesubsubsection}}
    {0pt}
    {}
\titlespacing*{\subsubsection}{2.50cm}{10pt plus 2pt minus 2pt}{4pt plus 2pt minus 1pt}

% --- 10. TColorBox Environments for Pedagogical Framework ---
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

% Modular Lesson Plan Box (Planbox) across 2 pages
\newtcolorbox{planbox}[2][]{
    enhanced,
    breakable,
    colback=white,
    colframe=plasmaNavy,
    fonttitle=\bfseries\fontsize{10.5}{13}\selectfont\color{white},
    coltitle=white,
    colbacktitle=plasmaNavy,
    title={#2},
    arc=1.5mm,
    boxrule=0.8pt,
